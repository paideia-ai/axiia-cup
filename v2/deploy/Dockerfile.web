FROM denoland/deno:2.9.1 AS builder

WORKDIR /app

COPY v2/web/deno.json v2/web/deno.lock v2/web/package.json ./
RUN deno install --frozen

COPY v2/web ./
# Footer build stamp (P1): CI passes the commit sha; vite inlines VITE_COMMIT_SHA.
ARG COMMIT_SHA=dev
ENV VITE_COMMIT_SHA=$COMMIT_SHA
# 测试模式看板的写入端点与匿名 key。不进仓库（这个 key 能写看板），由 CI 从
# secrets 传入；缺席时导测只读，其余功能不受影响。
ARG TM_BOARD_URL=
ARG TM_BOARD_ANON_KEY=
ENV VITE_TM_BOARD_URL=$TM_BOARD_URL
ENV VITE_TM_BOARD_ANON_KEY=$TM_BOARD_ANON_KEY
# PostHog 项目 key（phc_，按设计公开）。CI 从仓库变量 vars.POSTHOG_KEY 传入；
# 为空时前端不加载任何分析代码、不发任何请求。见 v2/README.md「Product analytics」。
ARG POSTHOG_KEY=
ENV VITE_POSTHOG_KEY=$POSTHOG_KEY
RUN deno task build

FROM nginx:1.27-alpine

COPY v2/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/client /usr/share/nginx/html

EXPOSE 80
