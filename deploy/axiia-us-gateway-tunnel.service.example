[Unit]
Description=Axiia US LLM gateway tunnel
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=AXIIA_US_GATEWAY_HOST=anna@reliablesite.tuna-miaplacidus.ts.net
Environment=AXIIA_US_GATEWAY_LOCAL_PORT=33100
ExecStart=/srv/axiia-cup/current/deploy/start-us-gateway-tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
