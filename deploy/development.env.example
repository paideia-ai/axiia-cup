# Public app origin
CORS_ORIGIN=https://cup-dev-114514.isofucius.cn

# Required secrets
# Reuse the same app secrets as production unless you intentionally want isolation.
JWT_SECRET=replace-with-a-long-random-secret
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key

# Optional judge/scorer gateway providers
# When using the US gateway, set both of these to the same GATEWAY_SHARED_TOKEN.
# Do not put real OpenAI / Anthropic provider keys on the China worker.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=

# Optional Langfuse telemetry (leave all four blank to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=

# Registration
REGISTRATION_CODE=axiia_cup

# API runtime
PORT=3001
WORKER_CONCURRENCY=8
AXIIA_DB_PATH=/data/axiia.db

# Docker host paths / ports
AXIIA_DATA_DIR=/srv/axiia-cup/shared/data/dev
WEB_HOST_PORT=8201
COMPOSE_PROJECT_NAME=axiia-dev

# Leave empty to use same-origin /api requests through nginx
VITE_API_URL=
