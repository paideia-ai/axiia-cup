# Public app origin
CORS_ORIGIN=https://axiia-cup.isofucius.cn

# Required secrets
JWT_SECRET=replace-with-a-long-random-secret
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key

# Optional Langfuse telemetry (leave all three blank to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Registration
REGISTRATION_CODE=axiia_cup

# API runtime
PORT=3001
WORKER_CONCURRENCY=8
AXIIA_DB_PATH=/data/axiia.db

# Docker host paths / ports
AXIIA_DATA_DIR=/srv/axiia-cup/shared/data
WEB_HOST_PORT=8200

# Leave empty to use same-origin /api requests through nginx
VITE_API_URL=
